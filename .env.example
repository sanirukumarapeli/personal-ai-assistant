# Environment variables (example)

Copy to `.env` in the project root and fill in real values.

# Required — GitHub Models
GITHUB_TOKEN=github_pat_your_fine_grained_token_with_models_read
GITHUB_MODEL_ID=openai/gpt-5

# Gmail / Google OAuth (see docs/YOU_GMAIL_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5080/signin-google

# Optional — Telegram
TELEGRAM_BOT_TOKEN=

# API
ASPNETCORE_URLS=http://localhost:5080
