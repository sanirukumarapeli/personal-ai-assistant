# Environment variables (example)

Copy to `.env` in the project root and fill in real values.

# Required — Google Gemini (AI Studio)
# Create a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here
# Chat + analyze images — AI Studio: Gemini 3.5 Flash Lite (~15 RPM / 500 RPD)
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Image generation — AI Studio name → API id:
#   Nano Banana 2 (Gemini 3.1 Flash Image)          → gemini-3.1-flash-image   (locked default)
#   Nano Banana 2 Lite (Gemini 3.1 Flash Lite Image) → gemini-3.1-flash-lite-image
#   Nano Banana (Gemini 2.5 Flash Preview Image)     → gemini-2.5-flash-preview-image
#   Nano Banana Pro (Gemini 3 Pro Image)             → gemini-3-pro-image
# (Imagen 4 / Veo are not used by this app)
GEMINI_IMAGE_MODEL_ID=gemini-3.1-flash-image
# Avoid full Flash on free tier (often 5 RPM / 20 RPD) for chat tool loops
# Optional override (OpenAI-compatible endpoint):
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/

# Gmail / Google OAuth (see docs/YOU_GMAIL_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5080/signin-google

# Optional — Discord (preferred phone channel; see docs/YOU_DISCORD_SETUP.md)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
# Optional — Telegram (leave empty if using Discord)
TELEGRAM_BOT_TOKEN=

# API
ASPNETCORE_URLS=http://localhost:5080
