# Environment variables (example)

Copy to `.env` in the project root and fill in real values.

# Required — Google Gemini (AI Studio)
# Create a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Same free RPM/RPD class: gemini-3.1-flash-lite (15 RPM / 500 RPD on many free projects)
# Avoid full Flash on free tier (often 5 RPM / 20 RPD) and retired 2.5 for new keys (404)
# Optional override (OpenAI-compatible endpoint):
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/

# Gmail / Google OAuth (see docs/YOU_GMAIL_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5080/signin-google

# Optional — Discord (preferred phone channel; see docs/YOU_DISCORD_SETUP.md)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
# Optional — Telegram (leave empty if using Discord)
TELEGRAM_BOT_TOKEN=

# API
ASPNETCORE_URLS=http://localhost:5080
